# Copy to .env.local and fill in. Never commit .env.local.

# Shared key that unlocks the private /home and /admin areas (gate 1, see docs/PRIVATE_AREA.md).
# Must also be set in Vercel → Project → Settings → Environment Variables.
PRIVATE_ACCESS_KEY=

# Supabase (project "astarapply", ref nvigkfmrxtxvylbhfcwa). Supabase → Project Settings → API.
# Also set the two NEXT_PUBLIC_ vars + the service role key in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
# Public key. New projects call this the "publishable key" — NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# is accepted as an alias.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser. Used by src/lib/supabase/admin.ts, seeds and e2e.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI used by `supabase` CLI for migrations only. Local .env.local only, not Vercel.
SUPABASE_DB_URL=
# Optional: absolute site origin used for auth redirect links when request headers are missing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (Loop 01+). console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
