# Copy to .env.local and fill in. Never commit .env.local.

# Shared key that unlocks the private /home and /admin areas (gate 1, see docs/PRIVATE_AREA.md).
# Must also be set in Vercel → Project → Settings → Environment Variables.
PRIVATE_ACCESS_KEY=

# Supabase (project "astarapply", ref nvigkfmrxtxvylbhfcwa). Supabase → Project Settings → API.
# Also set the two NEXT_PUBLIC_ vars + the service role key in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
# Public key. New projects call this the "publishable key" — NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# is accepted as an alias.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser. Used by src/lib/supabase/admin.ts, seeds and e2e.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI used by `supabase` CLI for migrations only. Local .env.local only, not Vercel.
SUPABASE_DB_URL=
# Optional: absolute site origin used for auth redirect links when request headers are missing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (Loop 01+). console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# --- Loop 01: mentor corpus ---
# Embeddings provider: "voyage" (needs VOYAGE_API_KEY) or "local" (deterministic hashed 1024-d,
# for dev/CI; retrieval evals are labelled "FTS-only"). Defaults to voyage when the key is set.
EMBEDDINGS_PROVIDER=local
# Optional. dash.voyageai.com → API keys. Leave empty to use the local provider.
VOYAGE_API_KEY=
# Private Supabase Storage bucket for mentor uploads (created by migration 0002).
CORPUS_BUCKET=corpus
# Directory holding the private 400Q PDF (never committed). Evals write only to $EVAL_HIDDEN_DIR/.eval/.
EVAL_HIDDEN_DIR=

# --- Loop 02: mentor chatbot ---
# Chat pipeline mode: "live" (Opus 5 + Haiku via the API) or "fixture" (real retrieval, deterministic
# answer built from the top chunks — used by Playwright/CI and whenever the key has no credit).
# Default: "auto" → probe the API once; fall back to fixture on a billing/auth error.
CHAT_MODE=
# Max assistant messages per user per day (usage_daily + increment_usage()). Default 60.
CHAT_DAILY_CAP=60
# Override the answer model (default claude-opus-5 from src/lib/ai/client.ts).
CHAT_MODEL=
# Judge model for `npm run eval -- --suite chat` (default claude-opus-5).
EVAL_JUDGE_MODEL=

# --- Loop 04: content generation (Batches) ---
# Hard cap on the estimated USD cost of one batch; `content:generate` aborts above it. Default 80.
CONTENT_MAX_BATCH_USD=80
# Override the writer/critic model (default claude-opus-5 from src/lib/ai/client.ts).
CONTENT_MODEL=

# --- Loop 07: mock interviews ---
# Voice answers (Web Speech API dictation in the browser; audio never uploaded). "on" | "off" (default off).
NEXT_PUBLIC_VOICE_MOCK=off
# Override the grader/report model (default claude-opus-5 from src/lib/ai/client.ts).
INTERVIEW_GRADER_MODEL=

# --- Loop 08: firm bank + Pulse ---
# Bearer secret Vercel Cron sends to GET /api/cron/pulse (Authorization: Bearer <CRON_SECRET>).
# Vercel sets it automatically when the env var exists on the project; any random string locally.
CRON_SECRET=
# "true" publishes each weekly digest as approved without review. Default false → digests wait
# as `generated` (student-invisible) in /admin/pulse.
PULSE_AUTO_PUBLISH=false
# Comma-separated allowed_domains for the Pulse research pass (web_search_20260209).
PULSE_ALLOWED_DOMAINS=ft.com,reuters.com,bloomberg.com,bbc.co.uk,economist.com,wsj.com
# Override the Pulse model (default claude-opus-5 from src/lib/ai/client.ts).
PULSE_MODEL=
