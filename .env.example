# Copy to .env.local and fill in. Never commit .env.local.

# Shared key that unlocks the private /home area (see docs/PRIVATE_AREA.md).
# Must also be set in Vercel → Project → Settings → Environment Variables.
PRIVATE_ACCESS_KEY=

# Supabase (project "astarapply"). Get from Supabase → Project Settings → API. Also set in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Session-pooler Postgres URI (port 5432) used for migrations only. Local .env.local only, not Vercel.
SUPABASE_DB_URL=
