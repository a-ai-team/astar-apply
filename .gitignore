# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli
supabase/.temp
!.env.example

# local eval artefacts / private fixtures / personal Claude notes
.eval/
fixtures/private/
CLAUDE.local.md

# playwright
/test-results/
/playwright-report/

# PDFs are never committed (fixture PDFs are generated by scripts/dev/make-fixtures.ts)
*.pdf

# Personal, per-project Claude Code overrides (never committed)
.claude/settings.local.json
